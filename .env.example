# API server
PORT=4000
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgres://toeic:toeic@localhost:5432/toeic_local

# Redis / Valkey
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=replace-me-with-strong-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Object storage (MinIO dev defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=toeic-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE=http://localhost:9000/toeic-media

# Worker
TTS_CONCURRENCY=3

# Azure TTS (optional)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE_US=en-US-EmmaNeural
AZURE_VOICE_GB=en-GB-LibbyNeural
AZURE_VOICE_AU=en-AU-NatashaNeural

# Piper (optional OSS fallback)
PIPER_URL=http://localhost:5000/synthesize
